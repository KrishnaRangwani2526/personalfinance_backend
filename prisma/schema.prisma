generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  phoneNumber   String    @unique
  name          String?
  isAdmin       Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  accounts      BankAccount[]
  cards         CardAccount[]
  transactions  Transaction[]
  emis          Emi[]
  templates     QuickEntryTemplate[]
  recurring     RecurringTransaction[]
  categories    Category[]
}

model BankAccount {
  id           String   @id @default(cuid())
  userId       String
  name         String
  bankName     String
  accountType  String   // "bank" or "wallet"
  sourceApp    String?  // "phonepe", "paytm", "gpay"
  isConfirmed  Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  anchors      BalanceAnchor[]

  // This model intentionally does not expose polymorphic child relations.
  // Only the user relation is kept for Prisma validation.
}

model CardAccount {
  id           String   @id @default(cuid())
  userId       String
  name         String
  bankName     String
  last4        String?
  billingDate  Int
  dueDate      Int
  creditLimit  Float?
  isConfirmed  Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cycles       BillingCycle[]

  // Keep the actual user relation; child records are fetched through app logic.
}

model Transaction {
  id          String   @id @default(cuid())
  userId      String
  linkedType  String   // "account" or "card"
  linkedId    String
  amount      Float
  direction   String   // "credit" or "debit"
  txnDate     String
  categoryId  String?
  description String?
  merchant    String?
  source      String   // "manual", "sms", "notification", "import", "template"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    Category? @relation(fields: [categoryId], references: [id])
}

model Category {
  id          String   @id @default(cuid())
  userId      String
  name        String
  isCustom    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
}

model Emi {
  id                 String   @id @default(cuid())
  userId             String
  linkedType         String   // "card" or "account"
  linkedId           String
  title              String
  description        String?
  monthlyAmount      Float
  startDate          String
  endDate            String
  totalInstallments  Int
  installmentsPaid   Int      @default(0)
  isRegularPayment   Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model QuickEntryTemplate {
  id          String   @id @default(cuid())
  userId      String
  linkedType  String   // "account" or "card"
  linkedId    String
  name        String
  description String?
  amount      Float
  direction   String   // "credit" or "debit"
  categoryId  String?
  isFavorite  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RecurringTransaction {
  id          String   @id @default(cuid())
  userId      String
  linkedType  String   // "account" or "card"
  linkedId    String
  name        String
  amount      Float
  direction   String   // "credit" or "debit"
  frequency   String   // "daily", "weekly", "monthly", "yearly"
  categoryId  String?
  nextDate    String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BalanceAnchor {
  id           String   @id @default(cuid())
  accountId    String
  asOfDate     String
  balanceAmount Float
  createdAt    DateTime @default(now())
  
  account      BankAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

model BillingCycle {
  id           String   @id @default(cuid())
  cardId       String
  cycleStart   String
  cycleEnd     String
  totalAmount  Float
  paidStatus   String   // "unpaid", "partial", "paid"
  createdAt    DateTime @default(now())
  
  card         CardAccount @relation(fields: [cardId], references: [id], onDelete: Cascade)
}
